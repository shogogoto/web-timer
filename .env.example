TIMER_PORT=8000
TIMER_IMAGE=ghcr.io/shogogoto/web-timer:latest
ADMIN_USERNAME=admin
ADMIN_PASSWORD=十分に長い初期パスワード
SESSION_SECRET=openssl-rand-hex-32などで生成したランダム文字列
COOKIE_SECURE=false
ALLOW_SHORT_TIMERS=false
# mailto:を含める（例: mailto:owner@example.com）
VAPID_SUBJECT=mailto:admin@example.com

# Cloudflare Tunnelを同じComposeで起動する場合のみ有効化
# COMPOSE_PROFILES=cloudflare
CLOUDFLARE_TUNNEL_TOKEN=
